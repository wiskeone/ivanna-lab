# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# База данных
DB_NAME=model_lab
DB_USER=ml_user
DB_PASSWORD=secure_password
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Hugging Face
HF_TOKEN=your_huggingface_token_optional
HF_CACHE_DIR=/root/.cache/huggingface

# Модели
DEFAULT_MODEL=Qwen/Qwen2.5-7B
MODEL_CACHE_DIR=/app/media/model_cache

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# ═══ vLLM (опционально; сервис запускается через --profile vllm) ═══
VLLM_BASE_URL=http://vllm:8001/v1
VLLM_SERVED_MODEL=default
VLLM_MODEL_PATH=/models/Qwen3.5-4B-Base
VLLM_PORT=8001
VLLM_MAX_MODEL_LEN=4096
VLLM_GPU_UTIL=0.85
VLLM_LOG_LEVEL=INFO
# Протестировано на GTX 1650 4GB с Qwen3-1.7B Q8_0 GGUF:
#   VLLM_MAX_MODEL_LEN=1024, VLLM_GPU_UTIL=0.85, и флаги
#   --enforce-eager + PYTORCH_ALLOC_CONF=expandable_segments:True
#   (CUDA-графы и 0.92+ на 4GB VRAM дают OOM при старте)
# VLLM_API_KEY=          # только если vLLM за прокси с авторизацией
