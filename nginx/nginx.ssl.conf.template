# v4: HTTPS-профиль nginx (опциональный).
#
# Использование:
#   1. Получите сертификаты (certbot/Let's Encrypt или свои):
#        nginx/ssl/fullchain.pem  — цепочка сертификата
#        nginx/ssl/privkey.pem    — приватный ключ
#   2. Подставьте свой домен вместо ivanna.example.com
#   3. В docker-compose для сервиса nginx добавьте:
#        volumes:
#          - ./nginx/nginx.ssl.conf.template:/etc/nginx/conf.d/default.conf:ro
#          - ./nginx/ssl:/etc/nginx/ssl:ro
#        ports:
#          - "80:80"
#          - "443:443"
#   4. docker-compose up -d nginx
#
# HTTP остаётся только для редиректа и ACME-челленджа.

server {
    listen 80;
    server_name ivanna.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ivanna.example.com;
    charset utf-8;

    ssl_certificate     /etc/nginx/ssl/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:ssl:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 200M;   # крупные датасеты/модели

    location /static/ {
        alias /app/static/;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # media/ содержит пользовательские документы — в проде лучше отдавать
    # через Django (проверка прав), а не статикой nginx.
    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;   # важно для Django CSRF
        proxy_redirect off;
        # долгие инференсы/файтюны не должны рваться по таймауту
        proxy_read_timeout 3000s;
        proxy_send_timeout 3000s;
    }
}
